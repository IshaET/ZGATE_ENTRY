@Metadata.layer:  #CORE

@UI: {
  headerInfo: { typeName: 'Gate Entry RGP/NRGP',
                typeNamePlural: 'Gate Entry RGP/NRGP',
                title: { type: #STANDARD, label: 'Gate Entry RGP/NRGP' , value: 'Zgate' }, imageUrl: 'PicUrl'
  }
  }
annotate entity ZC_GATEENTRY_hdr_R
    with 
{
   
   @UI.facet: [
  {
                    purpose: #HEADER,
                    type: #DATAPOINT_REFERENCE,
                    label: 'Status',
                    position: 20,
                    targetQualifier: 'status'
                },

