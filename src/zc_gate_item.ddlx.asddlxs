@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Gate PO Entry',
  typeNamePlural: 'Gate PO Entries',
  title: { value: 'Zgate' },
  description: { value: 'Ebeln' }
}
@UI.presentationVariant: [
  { sortOrder: [{ by: 'Zgate', direction: #DESC }] }
]
annotate entity ZC_GATEENTRY_ITM with
{
  @UI.facet: [
  {
   id: 'Item',
   purpose: #STANDARD,
   type: #IDENTIFICATION_REFERENCE,
   label: 'Gate PO Details',
   position: 10
  }
  ]
  zid;
  /* =========================
     KEYS
     ========================= */
  @UI: {
    lineItem:[{ position: 10, label: 'Gate No' }],
    identification:[{ position: 10, label: 'Gate No' }],
    selectionField:[{ position: 10 }]
  }
  Zgate;

  @UI: {
    lineItem:[{ position: 20, label: 'Purchase Order' }],
    identification:[{ position: 20, label: 'Purchase Order' }],
    selectionField:[{ position: 20 }]
  }
  @Search.defaultSearchElement: true
  @Consumption.valueHelpDefinition: [{
   entity: { name: 'ZI_PURORDITEM_VH', element: 'PurchaseOrder' },
   additionalBinding: [
   { localElement: '_ADV_HEAD.Plant', element: 'Plant' }
 ]
 //            additionalBinding: [{ localElement: 'Plant', element: 'Plant' } ]

 }]
  Ebeln;

  @UI: {
    lineItem:[{ position: 30, label: 'PO Item'}],
    identification:[{ position: 30, label: 'PO Item' }]
  }
  @Consumption.valueHelpDefinition: [{
   entity: { name: 'ZI_PURORDITEM_VH', element: 'PurchaseOrderItem' },
   additionalBinding: [{ localElement: 'Ebeln', element: 'PurchaseOrder' }]
 }]
  Ebelp;


  /* =========================
     VENDOR DETAILS
     ========================= */
  @UI: {
    lineItem:[{ position: 40, label: 'Vendor' }],
    identification:[{ position: 40, label: 'Vendor' }],
    selectionField:[{ position: 40 }]
  }
  Vend;

  @UI: {
    lineItem:[{ position: 50, label: 'Vendor Name' }],
    identification:[{ position: 50, label: 'Vendor Name' }]
  }
  Name;


  /* =========================
     MATERIAL DETAILS
     ========================= */
  @UI: {
    lineItem:[{ position: 60, label: 'Material' }],
    identification:[{ position: 60, label: 'Material' }],
    selectionField:[{ position: 60 }]
  }
  Mat;

  @UI: {
    lineItem:[{ position: 70, label: 'Material Description' }],
    identification:[{ position: 70, label: 'Material Description' }]
  }
  Matdesc;


  @UI: {
   lineItem:[{ position: 80, label: 'Storage Locatin' }],
   identification:[{ position: 80, label: 'Storage Locatin' }]
  }
  @Consumption.valueHelpDefinition: [{
     entity: {
       name: 'I_StorageLocation',
       element: 'StorageLocation'
     }
  }]
  storage;

  /* =========================
     QUANTITIES
     ========================= */
  @UI: {
    lineItem:[{ position: 90, label: 'Order Quantity' }],
    identification:[{ position: 90, label: 'Order Quantity' }]
  }
  OrderQty;

  @UI: {
    lineItem:[{ position: 100, label: 'Received Quantity' }],
    identification:[{ position: 100, label: 'Received Quantity' }]
  }
  ReceivedQty;

  @UI: {
    lineItem:[{ position: 110, label: 'Quantity' }],
    identification:[{ position: 110, label: 'Quantity' }]
  }
  qty;

  @UI: {
    lineItem:[{ position: 120, label: 'Unit of Measure' }],
    identification:[{ position: 120, label: 'Unit of Measure' }]
  }
  Uom;


  /* =========================
     BILL & REMARKS
     ========================= */
  @UI: {
    lineItem:[{ position: 130, label: 'Bill Number' }],
    identification:[{ position: 130, label: 'Bill Number' }]
  }
  BillNo;

  @UI: {
    lineItem:[{ position: 140, label: 'Remarks' }],
    identification:[{ position: 140, label: 'Remarks' }]
  }
  Remark;

  @UI: {
    lineItem:[{ position: 150, label: 'Material Doc' }],
    identification:[{ position: 150, label: 'Material Doc' }]
  }
  mblnr;

}


